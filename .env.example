# ==============================================================================
# Analytics Engineering - Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) & BigQuery
# ------------------------------------------------------------------------------
# Your GCP Project ID (used by BigQuery dbt profile, Cloud Run, Cloud Build, and Cloud Scheduler)
GCP_PROJECT_ID=your-gcp-project-id
# Optional alias for BigQuery
BQ_PROJECT_ID=your-gcp-project-id
# GCP Region for Cloud Run & Cloud Scheduler
GCP_REGION=northamerica-northeast1
# Cloud Run service name
SERVICE=analytics-dagster
# Email address for GCP Monitoring alert notifications (required for bootstrap_gcp.sh)
ALERT_EMAIL=your-email@example.com

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage (S3-compatible landing zone & Litestream backup)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
DAGSTER_R2_BUCKET=xkcd-ingest
DAGSTER_R2_PREFIX=dagster_home
COMICS_R2_PREFIX=raw_comics

# ------------------------------------------------------------------------------
# MotherDuck / DuckDB Database
# ------------------------------------------------------------------------------
# MotherDuck access token (required for cloud DuckDB)
MOTHERDUCK_TOKEN=your_motherduck_token
# MotherDuck target database name (e.g. md:data_warehouse_demo)
MOTHERDUCK_DATABASE=data_warehouse_demo
# dbt target: 'motherduck_dev' (cloud) or 'duckdb_dev' (local)
DBT_TARGET=motherduck_dev
# Local DuckDB file path (used if DBT_TARGET=duckdb_dev)
XKCD_DUCKDB_PATH=ingestion/orchestration_dagster/src/orchestration_dagster/defs/data/xkcd.duckdb

# ------------------------------------------------------------------------------
# Scheduling & Cloud Run Orchestration
# ------------------------------------------------------------------------------
JOB=dagster-comics-monthly
CHECK_JOB=dagster-comics-monthly-check
CRON_SCHEDULE="0 8 1 * *"
CHECK_CRON_SCHEDULE="0 12 1 * *"
WAKE_TIMEOUT_SECONDS=1500
WAKE_POLL_INTERVAL_SECONDS=10
INGESTION_MAX_WORKERS=20
